# En production, SERVER_IP est détecté automatiquement par deploy.sh --prod
SERVER_IP=localhost

# Domaine pointant vers ce serveur (requis en production, ex: monportfolio.com)
DOMAIN=
# Email pour les notifications Let's Encrypt (requis en production)
CERTBOT_EMAIL=

POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=db

NODE_ENV=development
PORT=3000
