# En production, SERVER_IP est détecté automatiquement par deploy.sh --prod
SERVER_IP=localhost

# Domaine pointant vers ce serveur (requis en production, ex: monportfolio.com)
DOMAIN=

POSTGRES_USER=admin
# Si le mot de passe contient des caractères spéciaux (&, #, $, …), le mettre entre quotes simples
POSTGRES_PASSWORD='password'
POSTGRES_DB=db

NODE_ENV=development
PORT=3000
